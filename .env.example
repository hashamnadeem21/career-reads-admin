# Postgres. Local: `npm run db:local` starts a private server on port 54329.
# Production: your Neon connection string (the same one the public site uses).
DATABASE_URL=postgres://postgres@localhost:54329/blognest

# The public site (blognest). Used for revalidation, "View on site" links and image previews.
PUBLIC_SITE_URL=http://localhost:3000
# Same value as REVALIDATE_SECRET on the public site. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Vercel Blob token for image uploads. Leave empty in development to store uploads in .data/uploads.
BLOB_READ_WRITE_TOKEN=

# Folder of the public site repo (used by `npm run db:import`).
BLOGNEST_DIR=../blognest
