# The Career Reads API (blognest-api). Local: http://localhost:4000.
# Vercel production deployments default to https://api-careersreads.com when this is empty.
API_URL=http://localhost:4000

# Same value as ADMIN_API_KEY in the API. Every call sends it as X-Api-Key, so the API
# trusts the visitor's IP we pass along (sign-in rate limits are per visitor).
ADMIN_API_KEY=

# The public site, for "View on site" links and image previews.
PUBLIC_SITE_URL=http://localhost:3000
